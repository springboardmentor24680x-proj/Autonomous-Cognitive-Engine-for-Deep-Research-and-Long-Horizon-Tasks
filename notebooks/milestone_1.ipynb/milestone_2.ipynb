# Cell 1: Setup
from main import graph
from langchain_core.messages import HumanMessage

# Cell 2: Multi-step VFS Test
# We ask the agent to do something, save it, and then we ask a follow-up
state = {"messages": [], "vfs": {}, "todos": []}

# Step A: Research and Save
prompt_1 = "Research the benefits of Mediterranean diet and save it to diet.txt"
state["messages"].append(HumanMessage(content=prompt_1))
result_1 = graph.invoke(state)

print(f"Files saved: {list(result_1['vfs'].keys())}")

# Step B: Read and Summarize
prompt_2 = "Read diet.txt and give me a 1-sentence summary of what you saved."
result_1["messages"].append(HumanMessage(content=prompt_2))
result_2 = graph.invoke(result_1)

print(f"Agent Final Response: {result_2['messages'][-1].content}")